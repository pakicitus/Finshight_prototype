# FinSight AI Configuration
# Replace with your actual LLM provider API key
LLM_API_KEY=your_api_key_here

# Model name (e.g., gpt-4o-mini, gpt-4o, claude-3-5-sonnet, llama3, etc.)
LLM_MODEL=gpt-4o-mini

# Optional base URL for OpenAI-compatible providers (Ollama, vLLM, LiteLLM, Groq, etc.)
# Leave blank or omit for standard OpenAI endpoints
LLM_BASE_URL=
